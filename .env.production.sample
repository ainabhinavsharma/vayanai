# ==============================================================================
# Vayanai cPanel Production Environment Configuration Sample
# ==============================================================================

# Node Environment
NODE_ENV=production

# Base URL of your deployed domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://vayanai.in.net

# Database configuration
DATABASE_PATH=data/vayanai.db

# ==============================================================================
# Production SMTP Mail Server Configuration (cPanel Webmail)
# ==============================================================================
SMTP_HOST=mail.vayanai.in.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contactus@vayanai.in.net
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Vayanai Admissions & Talent Council" <contactus@vayanai.in.net>

# ==============================================================================
# Google Sheets Registration Ingestion
# ==============================================================================
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1koeFclx1MsMM_cQXk3hrU-JTLXlj3OGrDegQIG9-Zio/export?format=csv&gid=1670509518

# ==============================================================================
# Cron & Automation Security
# ==============================================================================
CRON_SECRET=your_cron_secret_here

# ==============================================================================
# Primary Admin Credentials
# ==============================================================================
ADMIN_DEFAULT_EMAIL=contactus@vayanai.in.net
ADMIN_DEFAULT_PASSWORD=your_admin_password_here
